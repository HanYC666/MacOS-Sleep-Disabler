[Unit]
Description=Sleep Disabler GNOME Wayland prototype
PartOf=graphical-session.target
# With target default dependencies, wanted services run before the target.
# Do not add an After dependency that can conflict with that ordering.
CollectMode=inactive-or-failed

[Service]
Type=dbus
BusName=org.sleepdisabler.App
ExecStart=@AGENT_LAUNCHER@
Environment=@STATE_HOME_ENV@
TimeoutStartSec=20
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
